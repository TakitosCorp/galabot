DISCORD_TOKEN=your_discord_bot_token
DISCORD_ID=your_discord_application_id
# Guild/server id — used by the emoji-sync script (npm run sync-emojis).
GALA_DISCORD_ID=your_discord_guild_id
# Personal Discord user id of the streamer. Bot @-mentions of this account
# trigger the warn/ban escalation instead of an AI reply.
GALA_USER_ID=gala_personal_discord_user_id
DISCORD_NOTIFICATION_CHANNEL=your_notification_channel_id
DISCORD_NOTIFICATION_ROLE_ID=your_role_id_or_leave_blank
MOD_ROLE_ID=your_moderator_role_id
SPANISH_CHANNEL_ID=your_spanish_channel_id

TWITCH_CHANNEL=your_twitch_channel_name
TWITCH_USERNAME=your_twitch_username
TWITCH_URL=https://twitch.tv/your_channel

YOUTUBE_CHANNEL_ID=your_youtube_channel_id
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_API_KEY_2=optional_fallback_api_key
YOUTUBE_URL=https://youtube.com/@your_channel
YOUTUBE_BLACKLIST_IDS=video_id_to_skip,another_video_id

POST_DATA_WEBHOOK=https://your-webhook-url

ENABLE_DISCORD=true
ENABLE_TWITCH=true
ENABLE_YOUTUBE=true

# Set to true to auto-create Discord Guild Scheduled Events for upcoming streams.
# Requires the bot to have the MANAGE_EVENTS permission in the server.
DISCORD_EVENTS_ENABLED=false

PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# AI replies via Google Gemini (optional — feature is silently skipped when GEMINI_API_KEY is unset).
# Get a key at https://aistudio.google.com/apikey
# GEMINI_MODEL defaults to gemma-4-26b-a4b-it when not set.
# GEMINI_API_KEY_2 is an optional fallback key (e.g. a second free-tier project) used
#   automatically when the primary key returns 429 RPM/RPD-exhausted. After both keys
#   are exhausted, AI replies pause for GEMINI_QUOTA_COOLDOWN_MS (1 h by default).
# GEMINI_NO_LIMITS_IDS is a comma-separated list of Discord user ids exempt from the rate limit.
# Set GEMINI_ENABLE=false to disable AI replies entirely without removing GEMINI_API_KEY.
# Set GEMINI_DEBUG_LOG=true to write the full injected context (user info, conversation history,
#   stream data) and the raw model response to logs/ai.log. Off by default — only enable when
#   debugging prompt behaviour, as it logs potentially sensitive user data.
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_API_KEY_2=optional_fallback_api_key
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_NO_LIMITS_IDS=user_id_1,user_id_2
# Set GEMINI_WHITELIST_ONLY=true to restrict AI replies to GEMINI_NO_LIMITS_IDS only.
GEMINI_WHITELIST_ONLY=false
GEMINI_ENABLE=true
GEMINI_DEBUG_LOG=false
