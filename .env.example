# ─── Discord ────────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=your_discord_bot_token

# Application (client) ID from the General Information page
DISCORD_ID=your_discord_application_id

# The ID of the Discord server (guild) the bot operates in
GALA_DISCORD_ID=your_discord_guild_id

# Personal Discord user ID of Gala — pinging this account triggers the warn/ban handler
GALA_USER_ID=gala_personal_discord_user_id

# Channel ID where stream/event notifications are posted
DISCORD_NOTIFICATION_CHANNEL=your_notification_channel_id

# Role ID to @mention in notifications — leave blank to disable role pings
DISCORD_NOTIFICATION_ROLE_ID=your_role_id_or_leave_blank

# Role ID for moderators (used for permission checks in some commands)
MOD_ROLE_ID=your_moderator_role_id

# Channel ID that should be treated as the Spanish-language channel
SPANISH_CHANNEL_ID=your_spanish_channel_id

# Reaction-role mappings, namespaced by group (e.g. RULES for /rules). Optional —
# only needed if you want reacting to a message to grant a role. Format:
#   REACTION_ROLE_{GROUP}_EMOJI{N}=emoji:roleId
# Supports Unicode emoji and custom Discord emoji (<:name:id> / <a:name:id>).
# Repeat EMOJI1, EMOJI2, ... for multiple reaction/role pairs in the same group.
# REACTION_ROLE_RULES_EMOJI1=🦖:your_role_id

# ─── Twitch ──────────────────────────────────────────────────────────────────────
# Twitch channel name (lowercase, no URL prefix)
TWITCH_CHANNEL=your_twitch_channel_name

# Twitch account username the bot authenticates as
TWITCH_USERNAME=your_twitch_username

# Full Twitch channel URL (used when building notification embeds)
TWITCH_URL=https://twitch.tv/your_channel

# ─── YouTube ─────────────────────────────────────────────────────────────────────
# YouTube channel ID (starts with UC…)
YOUTUBE_CHANNEL_ID=your_youtube_channel_id

# YouTube Data API v3 key — get one at https://console.cloud.google.com
YOUTUBE_API_KEY=your_youtube_api_key

# Optional second API key used as a fallback when the primary key hits quota
YOUTUBE_API_KEY_2=optional_fallback_api_key

# Full YouTube channel URL (used when building notification embeds)
YOUTUBE_URL=https://youtube.com/@your_channel

# Comma-separated list of YouTube video IDs to skip when polling for streams
YOUTUBE_BLACKLIST_IDS=video_id_to_skip,another_video_id

# ─── Webhooks ────────────────────────────────────────────────────────────────────
# Webhook URL used to post stream data to an external service
POST_DATA_WEBHOOK=https://your-webhook-url

# ─── Feature flags ───────────────────────────────────────────────────────────────
# Set any of these to false to disable that platform integration at startup
ENABLE_DISCORD=true
ENABLE_TWITCH=true
ENABLE_YOUTUBE=true

# Set to true to enable Discord scheduled events sync (creates/updates events from stream schedule)
DISCORD_EVENTS_ENABLED=false

# ─── Puppeteer ───────────────────────────────────────────────────────────────────
# Absolute path to the Chromium executable used by Puppeteer
# On most Linux servers: /usr/bin/chromium or /usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ─── Google Gemini (AI replies) ──────────────────────────────────────────────────
# AI replies via Google Gemini — the feature is silently skipped when GEMINI_API_KEY is unset.
# Get a key at https://aistudio.google.com/apikey
#
# GEMINI_API_KEY_2      Optional fallback key (e.g. a second free-tier project). Used
#                       automatically when the primary key returns 429 RPM/RPD-exhausted.
#                       After both keys are exhausted, AI replies pause for
#                       GEMINI_QUOTA_COOLDOWN_MS (1 h by default).
#
# GEMINI_MODEL          Model ID to use. Defaults to gemma-4-26b-a4b-it when unset.
#
# GEMINI_NO_LIMITS_IDS  Comma-separated Discord user IDs exempt from the per-user rate limit.
#
# GEMINI_WHITELIST_ONLY When true, only users in GEMINI_NO_LIMITS_IDS can trigger AI replies.
#
# GEMINI_ENABLE         Set to false to disable AI replies entirely without removing the key.
#
# GEMINI_DEBUG_LOG      Set to true to write the full injected context (user info, conversation
#                       history, stream data) and raw model response to logs/ai.log.
#                       Off by default — only enable when debugging prompt behaviour,
#                       as it logs potentially sensitive user data.
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_API_KEY_2=optional_fallback_api_key
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_NO_LIMITS_IDS=user_id_1,user_id_2
GEMINI_WHITELIST_ONLY=false
GEMINI_ENABLE=true
GEMINI_DEBUG_LOG=false
